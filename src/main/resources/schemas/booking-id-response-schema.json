{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "CreateBookingResponse",
  "description": "Body of POST /booking: the generated id plus the stored booking",
  "type": "object",
  "properties": {
    "bookingid": { "type": "integer", "minimum": 1 },
    "booking": { "$ref": "#/definitions/booking" }
  },
  "required": ["bookingid", "booking"],
  "definitions": {
    "booking": {
      "type": "object",
      "properties": {
        "firstname": { "type": "string" },
        "lastname": { "type": "string" },
        "totalprice": { "type": "integer" },
        "depositpaid": { "type": "boolean" },
        "bookingdates": {
          "type": "object",
          "properties": {
            "checkin": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "checkout": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          },
          "required": ["checkin", "checkout"]
        },
        "additionalneeds": { "type": "string" }
      },
      "required": ["firstname", "lastname", "totalprice", "depositpaid", "bookingdates"]
    }
  }
}
